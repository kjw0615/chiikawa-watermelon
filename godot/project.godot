; Engine configuration file.
config_version=5

[application]

config/name="Chiikawa Heads 2.5D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Supabase="*res://scripts/supabase_client.gd"
Audio="*res://scripts/audio_manager.gd"

[gui]

theme/custom_font="res://assets/fonts/body_font.tres"

[display]

window/size/viewport_width=800
window/size/viewport_height=800
window/size/window_width_override=1205
window/size/window_height_override=1205
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=1400.0
2d/solver/default_contact_bias=0.3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.93, 0.9, 0.98, 1)
