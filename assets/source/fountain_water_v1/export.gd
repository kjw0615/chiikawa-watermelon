extends SceneTree
## Offline resizing/layer composition only. Artwork generated by built-in image_gen.
func _initialize() -> void:
	var root_path := ProjectSettings.globalize_path("res://").path_join("..").simplify_path()
	var folder := root_path.path_join("godot/assets/effects/fountain")
	DirAccess.make_dir_recursive_absolute(folder)
	for job in [["water_column", Vector2i(512, 1024)], ["splash_cap", Vector2i(1024, 512)]]:
		var picture := Image.load_from_file(root_path.path_join("assets/source/fountain_water_v1/masters/%s.png" % job[0]))
		if picture == null or picture.is_empty():
			quit(1)
			return
		picture.convert(Image.FORMAT_RGBA8)
		var size_target: Vector2i = job[1]
		var target_ratio := float(size_target.x) / size_target.y
		if absf(float(picture.get_width()) / picture.get_height() - target_ratio) > 0.001:
			push_error("Unexpected generated aspect ratio: " + job[0])
			quit(1)
			return
		picture.resize(size_target.x, size_target.y, Image.INTERPOLATE_LANCZOS)
		if picture.save_png(folder.path_join(job[0] + ".png")) != OK:
			quit(1)
			return
		print(job[0], " => ", picture.get_size())
	var combined := Image.create(512, 768, false, Image.FORMAT_RGBA8)
	combined.fill(Color.TRANSPARENT)
	var column := Image.load_from_file(folder.path_join("water_column.png"))
	column.convert(Image.FORMAT_RGBA8)
	column.resize(160, 480, Image.INTERPOLATE_LANCZOS)
	combined.blend_rect(column, Rect2i(0, 0, 160, 480), Vector2i(176, 144))
	var cap := Image.load_from_file(folder.path_join("splash_cap.png"))
	cap.convert(Image.FORMAT_RGBA8)
	cap.resize(480, 240, Image.INTERPOLATE_LANCZOS)
	combined.blend_rect(cap, Rect2i(0, 0, 480, 240), Vector2i(16, 64))
	combined.save_png(folder.path_join("fountain_combined.png"))
	var review := Image.create(1024, 768, false, Image.FORMAT_RGBA8)
	review.fill(Color("fff8eb"))
	var dark := Image.create(512, 768, false, Image.FORMAT_RGBA8)
	dark.fill(Color("263f4c"))
	review.blit_rect(dark, Rect2i(0, 0, 512, 768), Vector2i(512, 0))
	review.blend_rect(combined, Rect2i(0, 0, 512, 768), Vector2i.ZERO)
	review.blend_rect(combined, Rect2i(0, 0, 512, 768), Vector2i(512, 0))
	review.save_png(root_path.path_join("assets/source/fountain_water_v1/review.png"))
	quit()
